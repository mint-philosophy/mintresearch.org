---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Data Dash 64 — MINT Lab">
  <main class="dd64-page">
    <section class="dd64-hero">
      <nav class="dd64-version-switch" aria-label="Data Dash versions">
        <a href={`${base}/data-dash/`} class="dd64-pill">Data Dash 1</a>
        <span class="dd64-pill is-active">Data Dash 64</span>
      </nav>

      <p class="dd64-kicker">A new generation of Data Dash</p>
      <h1>Data Dash 64</h1>
      <p class="dd64-sub">
        Minty drops beneath the platform feeds and into the infrastructure itself:
        floating datacores, moving data-bridges, hostile slop drones, and an inference crown
        waiting in the dark.
      </p>
    </section>

    <section class="dd64-grid">
      <div class="dd64-console">
        <div class="dd64-titlebar">
          <span class="dd64-dot" style="background:var(--red)"></span>
          <span class="dd64-dot" style="background:var(--yellow)"></span>
          <span class="dd64-dot" style="background:var(--green)"></span>
          <span class="dd64-title">data-dash-64 — three.js — 3d runtime</span>
        </div>

        <div class="dd64-stage" id="dd64-stage">
          <div id="dd64-canvas" class="dd64-canvas" data-asset-base={base}></div>

          <div class="dd64-overlay">
            <div class="dd64-topbar">
              <div class="dd64-chip">
                <span class="dd64-chip-label">Objective</span>
                <span id="dd64-objective">Collect 12 signal papers to open the core gate.</span>
              </div>
              <div class="dd64-chip-row">
                <div class="dd64-chip small">
                  <span class="dd64-chip-label">Score</span>
                  <span id="dd64-score">0</span>
                </div>
                <div class="dd64-chip small">
                  <span class="dd64-chip-label">Best</span>
                  <span id="dd64-best">0</span>
                </div>
              </div>
            </div>

            <div class="dd64-status">
              <div class="dd64-meter-card">
                <span class="dd64-meter-label">Integrity</span>
                <div class="dd64-meter">
                  <div id="dd64-health-fill" class="dd64-meter-fill health"></div>
                </div>
              </div>
              <div class="dd64-meter-card">
                <span class="dd64-meter-label">Dash Core</span>
                <div class="dd64-meter">
                  <div id="dd64-dash-fill" class="dd64-meter-fill dash"></div>
                </div>
              </div>
              <div class="dd64-chip papers">
                <span class="dd64-chip-label">Signal Papers</span>
                <span id="dd64-paper-count">0 / 12</span>
              </div>
            </div>

            <div id="dd64-boss-wrap" class="dd64-boss-wrap">
              <span class="dd64-boss-label">Inference Crown</span>
              <div class="dd64-boss-meter">
                <div id="dd64-boss-fill" class="dd64-boss-fill"></div>
              </div>
            </div>

            <div id="dd64-toast" class="dd64-toast">Minty is dropping into the stack.</div>

            <div id="dd64-finish" class="dd64-finish">
              <div class="dd64-finish-card">
                <p class="dd64-finish-kicker">Run status</p>
                <h2 id="dd64-finish-heading">Data Dash 64</h2>
                <p id="dd64-finish-copy">
                  Minty is poised on the edge of the new stack.
                </p>
                <div class="dd64-finish-actions">
                  <button id="dd64-restart" type="button" class="dd64-action primary">Restart Run</button>
                  <a href={`${base}/data-dash/`} class="dd64-action">Play Classic</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <aside class="dd64-briefing">
        <div class="dd64-brief-card">
          <p class="dd64-brief-kicker">Generation shift</p>
          <h2>From side-scroll to 3D dash</h2>
          <ul class="dd64-list">
            <li>New runtime on Three.js, separate from the original Phaser game.</li>
            <li>Third-person Minty with jump, dash, projectile fire, and moving platforms.</li>
            <li>Signal-paper collection loop, enemy drones, boost pads, and a boss arena.</li>
            <li>Classic and new versions stay on separate pages so the old one remains intact.</li>
          </ul>
        </div>

        <div class="dd64-brief-card">
          <p class="dd64-brief-kicker">Controls</p>
          <ul class="dd64-list controls">
            <li><code>W A S D</code> or arrows to move</li>
            <li><code>Space</code> to jump</li>
            <li><code>Shift</code> to dash</li>
            <li><code>J</code> or <code>Z</code> to fire papers</li>
            <li><code>R</code> to restart the run</li>
          </ul>
        </div>
      </aside>
    </section>

    <div class="dd64-mobile-blocker">
      <img src={`${base}/assets/minty-bandaged.png`} alt="Bandaged Minty" class="dd64-mobile-minty" />
      <p>This sequel wants a desktop keyboard. Minty refuses to deep-dive the stack on a phone.</p>
    </div>
  </main>

  <script>
    import { createDataDash64 } from '../game64/index';

    const canvasHost = document.getElementById('dd64-canvas');
    const assetBase = canvasHost?.dataset.assetBase ?? '';
    const mobileCheck =
      /iPhone|iPad|iPod|Android/i.test(navigator.userAgent) ||
      (window.innerWidth <= 900 && 'ontouchstart' in window);

    if (mobileCheck) {
      document.body.classList.add('dd64-mobile-mode');
    } else {
      try {
        await createDataDash64({
          parentId: 'dd64-canvas',
          assetBase,
        });
      } catch (error) {
        console.error(error);
        const objective = document.getElementById('dd64-objective');
        const toast = document.getElementById('dd64-toast');
        if (objective) {
          objective.textContent = error instanceof Error ? error.message : 'Data Dash 64 failed to boot.';
        }
        if (toast) {
          toast.textContent = 'Runtime error. Check console.';
          toast.classList.add('is-visible');
        }
      }
    }
  </script>

  <style>
    .dd64-page {
      --dd64-panel: rgba(8, 11, 20, 0.88);
      --dd64-panel-strong: rgba(7, 10, 16, 0.96);
      --dd64-line: rgba(93, 232, 218, 0.28);
      --dd64-cyan: #5de8da;
      --dd64-blue: #79d6ff;
      --dd64-amber: #ffb347;
      --dd64-red: #ff896f;
      position: relative;
      max-width: 1240px;
      margin: 0 auto;
      padding: 34px 24px 72px;
    }

    .dd64-page::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at top, rgba(93, 232, 218, 0.08), transparent 32%),
        linear-gradient(180deg, rgba(8, 12, 20, 0.2), rgba(8, 12, 20, 0.65)),
        repeating-linear-gradient(
          180deg,
          rgba(121, 214, 255, 0.03) 0,
          rgba(121, 214, 255, 0.03) 1px,
          transparent 1px,
          transparent 8px
        );
      pointer-events: none;
      z-index: 0;
    }

    .dd64-hero,
    .dd64-grid,
    .dd64-mobile-blocker {
      position: relative;
      z-index: 1;
    }

    .dd64-version-switch {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin: 0 0 18px;
    }

    .dd64-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 140px;
      padding: 9px 16px;
      border: 1px dashed var(--dd64-line);
      background: var(--dd64-panel);
      color: var(--text-2);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      font-size: 10px;
      transition: border-color 160ms ease, color 160ms ease, transform 160ms ease;
    }

    .dd64-pill:hover {
      border-color: var(--dd64-cyan);
      color: var(--text-1);
      transform: translateY(-1px);
    }

    .dd64-pill.is-active {
      border-color: var(--dd64-cyan);
      color: var(--dd64-cyan);
      box-shadow: 0 0 28px rgba(93, 232, 218, 0.14);
    }

    .dd64-hero {
      text-align: center;
      margin-bottom: 26px;
    }

    .dd64-kicker,
    .dd64-brief-kicker,
    .dd64-finish-kicker {
      margin: 0 0 8px;
      color: var(--dd64-cyan);
      text-transform: uppercase;
      letter-spacing: 0.24em;
      font-size: 10px;
    }

    .dd64-hero h1 {
      margin: 0;
      font-size: clamp(2.6rem, 8vw, 4.9rem);
      line-height: 0.95;
      color: #f2f6ff;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      text-shadow:
        0 0 28px rgba(93, 232, 218, 0.18),
        0 0 46px rgba(121, 214, 255, 0.12);
    }

    .dd64-sub {
      max-width: 760px;
      margin: 14px auto 0;
      color: var(--text-2);
      font-size: 15px;
      line-height: 1.6;
    }

    .dd64-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.7fr) minmax(280px, 0.8fr);
      gap: 22px;
      align-items: start;
    }

    .dd64-console,
    .dd64-brief-card {
      border: 1px dashed var(--dd64-line);
      background: var(--dd64-panel);
      box-shadow: 0 0 40px rgba(6, 14, 24, 0.5);
    }

    .dd64-titlebar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      border-bottom: 1px dashed var(--dd64-line);
      background: rgba(6, 8, 14, 0.92);
    }

    .dd64-dot {
      width: 10px;
      height: 10px;
      flex: 0 0 10px;
    }

    .dd64-title {
      margin-left: auto;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 10px;
    }

    .dd64-stage {
      position: relative;
      min-height: 640px;
      overflow: hidden;
      background:
        radial-gradient(circle at top, rgba(93, 232, 218, 0.06), transparent 24%),
        linear-gradient(180deg, #050912, #03050a);
    }

    .dd64-canvas {
      position: absolute;
      inset: 0;
    }

    .dd64-overlay {
      position: absolute;
      inset: 0;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 14px;
    }

    .dd64-topbar,
    .dd64-status {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      justify-content: space-between;
    }

    .dd64-chip-row {
      display: flex;
      gap: 10px;
    }

    .dd64-chip,
    .dd64-meter-card {
      min-width: 0;
      border: 1px dashed rgba(121, 214, 255, 0.24);
      background: rgba(4, 7, 12, 0.84);
      padding: 10px 12px;
      color: var(--text-1);
      box-shadow: 0 0 26px rgba(6, 14, 24, 0.32);
    }

    .dd64-chip {
      display: flex;
      flex-direction: column;
      gap: 4px;
      max-width: 360px;
    }

    .dd64-chip.small {
      min-width: 90px;
    }

    .dd64-chip.papers {
      min-width: 122px;
      align-self: flex-end;
    }

    .dd64-chip-label,
    .dd64-meter-label,
    .dd64-boss-label {
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.18em;
      font-size: 9px;
    }

    .dd64-meter-card {
      width: min(220px, 100%);
    }

    .dd64-meter,
    .dd64-boss-meter {
      position: relative;
      height: 10px;
      overflow: hidden;
      border: 1px solid rgba(93, 232, 218, 0.18);
      background: rgba(4, 8, 14, 0.94);
      margin-top: 8px;
    }

    .dd64-meter-fill,
    .dd64-boss-fill {
      position: absolute;
      inset: 0;
      transform-origin: left center;
      transform: scaleX(1);
    }

    .dd64-meter-fill.health {
      background: linear-gradient(90deg, #ff896f, #ffcc70);
    }

    .dd64-meter-fill.dash {
      background: linear-gradient(90deg, #5de8da, #79d6ff);
    }

    .dd64-boss-fill {
      background: linear-gradient(90deg, #c678dd, #ff7cae);
    }

    .dd64-boss-wrap {
      align-self: center;
      width: min(360px, calc(100% - 48px));
      padding: 10px 12px;
      border: 1px dashed rgba(198, 120, 221, 0.26);
      background: rgba(8, 4, 12, 0.9);
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 180ms ease, transform 180ms ease;
    }

    .dd64-boss-wrap.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .dd64-toast {
      align-self: center;
      max-width: min(540px, calc(100% - 48px));
      padding: 10px 14px;
      border: 1px dashed rgba(255, 179, 71, 0.26);
      background: rgba(16, 10, 2, 0.88);
      color: #ffe5b5;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 10px;
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 180ms ease, transform 180ms ease;
    }

    .dd64-toast.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .dd64-finish {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 22px;
      background: rgba(2, 5, 9, 0.72);
      opacity: 0;
      pointer-events: none;
      transition: opacity 180ms ease;
    }

    .dd64-finish.is-visible {
      opacity: 1;
      pointer-events: auto;
    }

    .dd64-finish-card {
      width: min(520px, 100%);
      border: 1px dashed rgba(93, 232, 218, 0.28);
      background: var(--dd64-panel-strong);
      padding: 24px;
      text-align: center;
      box-shadow: 0 0 44px rgba(5, 12, 22, 0.5);
    }

    .dd64-finish-card h2 {
      margin: 0 0 12px;
      color: #f3f7ff;
      font-size: 28px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .dd64-finish-card p {
      margin: 0;
      color: var(--text-2);
      line-height: 1.6;
    }

    .dd64-finish-actions {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-top: 22px;
      pointer-events: auto;
    }

    .dd64-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 140px;
      padding: 11px 16px;
      border: 1px dashed rgba(93, 232, 218, 0.28);
      background: rgba(7, 10, 16, 0.88);
      color: var(--text-1);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-size: 10px;
      cursor: pointer;
    }

    .dd64-action.primary {
      background: rgba(13, 28, 28, 0.96);
      color: var(--dd64-cyan);
      border-color: rgba(93, 232, 218, 0.42);
    }

    .dd64-briefing {
      display: grid;
      gap: 18px;
    }

    .dd64-brief-card {
      padding: 18px 18px 20px;
    }

    .dd64-brief-card h2 {
      margin: 0 0 12px;
      color: #eef4ff;
      font-size: 20px;
      line-height: 1.2;
    }

    .dd64-list {
      margin: 0;
      padding-left: 18px;
      color: var(--text-2);
      line-height: 1.7;
      font-size: 14px;
    }

    .dd64-list.controls code {
      color: var(--dd64-cyan);
    }

    .dd64-mobile-blocker {
      display: none;
      margin-top: 20px;
      border: 1px dashed rgba(255, 137, 111, 0.22);
      background: rgba(15, 7, 8, 0.92);
      padding: 24px;
      text-align: center;
    }

    .dd64-mobile-minty {
      width: 110px;
      image-rendering: pixelated;
      margin-bottom: 12px;
    }

    :global(body.dd64-mobile-mode) .dd64-console,
    :global(body.dd64-mobile-mode) .dd64-briefing {
      display: none;
    }

    :global(body.dd64-mobile-mode) .dd64-mobile-blocker {
      display: block;
    }

    @media (max-width: 1120px) {
      .dd64-grid {
        grid-template-columns: 1fr;
      }

      .dd64-stage {
        min-height: 560px;
      }
    }

    @media (max-width: 760px) {
      .dd64-page {
        padding-inline: 16px;
      }

      .dd64-topbar,
      .dd64-status {
        flex-direction: column;
      }

      .dd64-chip-row {
        width: 100%;
        justify-content: stretch;
      }

      .dd64-chip.small,
      .dd64-meter-card {
        width: 100%;
      }

      .dd64-finish-actions {
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>
