---
// Interactive prototype — tap cards, authorize units, pick sectors, resolve attacks.
// Phone-first layout, no site chrome.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>RTS — Interactive Prototype</title>
  <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
</head>
<body>
  <div id="rts-root"></div>

  <script>
    import { mount } from "../../game/rts/prototype";
    mount();
  </script>

  <style is:global>
    :root {
      --paper: #e8dfc9;
      --paper-dark: #d4c9ae;
      --paper-deeper: #c4b795;
      --ink: #1a1612;
      --ink-soft: #4a413a;
      --ink-faint: #7b6e62;
      --union: #1e3a5f;
      --union-soft: #2d4a6f;
      --csa: #6b3a2b;
      --csa-soft: #8b5a4b;
      --gold: #a98636;
      --gold-soft: #c6a858;
      --danger: #8b2f2f;
      --ok: #3f5d3d;
      --warn: #b77a1e;
      --rule: #a09078;
      --serif: "Hoefler Text", "Baskerville", Georgia, serif;
      --sans: -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
      --mono: "SF Mono", "Menlo", monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      background: #2a2520;
      font-family: var(--sans);
      color: var(--ink);
      min-height: 100vh;
    }

    body {
      display: flex;
      justify-content: center;
      padding: 20px;
    }

    #rts-root { width: 100%; max-width: 420px; position: relative; }

    .phone {
      width: 100%;
      max-width: 390px;
      margin: 0 auto;
      min-height: 844px;
      background: var(--paper);
      background-image:
        radial-gradient(circle at 20% 30%, rgba(139,115,80,0.08) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(139,115,80,0.06) 0%, transparent 50%);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,0.4);
      display: flex;
      flex-direction: column;
      position: relative;
    }

    /* TOP BAR */
    .topbar {
      background: var(--union);
      color: var(--paper);
      padding: 14px 18px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid var(--gold);
    }
    .topbar .turn {
      font-family: var(--serif);
      font-size: 22px;
      letter-spacing: 0.5px;
    }
    .topbar .phase {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      opacity: 0.85;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .your-turn-dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--gold);
      box-shadow: 0 0 6px var(--gold);
    }
    .topbar .player-col { text-align: right; }
    .topbar .player {
      font-family: var(--serif);
      font-size: 13px;
      font-style: italic;
    }
    .topbar .side {
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      opacity: 0.8;
    }

    /* VICTORY */
    .victory {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 18px;
      background: #15283f;
      color: var(--paper);
      font-size: 10px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .victory-side { display: flex; align-items: center; gap: 6px; }
    .victory-label { opacity: 0.7; }
    .banner-row { display: inline-flex; gap: 3px; }
    .banner {
      width: 10px;
      height: 12px;
      background: transparent;
      border: 1px solid var(--paper);
      opacity: 0.35;
    }
    .banner.taken { background: var(--gold); border-color: var(--gold); opacity: 1; }
    .banner.taken.csa { background: var(--csa-soft); border-color: var(--csa-soft); }

    /* PROMPT */
    .prompt {
      padding: 12px 18px;
      background: var(--paper-dark);
      border-bottom: 1px solid var(--rule);
    }
    .prompt-header {
      font-family: var(--serif);
      font-style: italic;
      font-size: 12px;
      color: var(--ink-soft);
      margin-bottom: 4px;
    }
    .prompt-text {
      font-family: var(--serif);
      font-size: 13px;
      line-height: 1.4;
    }

    /* SECTIONS */
    .section {
      padding: 12px 18px 8px;
      border-bottom: 1px solid var(--rule);
    }
    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 8px;
    }
    .section-title {
      font-family: var(--serif);
      font-size: 14px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .section-meta {
      font-family: var(--mono);
      font-size: 10px;
      color: var(--ink-faint);
    }

    /* HAND */
    .hand {
      padding: 12px 0 8px;
      border-bottom: 1px solid var(--rule);
    }
    .hand-header {
      padding: 0 18px 8px;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    .strain-banner {
      margin: 0 18px 8px;
      padding: 8px 10px;
      background: rgba(139,47,47,0.08);
      border: 1px solid var(--danger);
      border-left-width: 3px;
      border-radius: 3px;
      font-family: var(--serif);
      font-size: 11px;
      line-height: 1.35;
      color: var(--ink);
    }
    .spy-list {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-bottom: 8px;
    }
    .spy-row {
      display: grid;
      grid-template-columns: 110px 1fr;
      gap: 8px;
      align-items: baseline;
      padding: 7px 9px;
      background: var(--paper);
      border: 1px solid var(--rule);
      border-left: 3px solid var(--gold);
      border-radius: 3px;
      font-size: 11px;
    }
    .spy-cat {
      font-family: var(--mono);
      font-size: 9px;
      color: var(--ink-faint);
      letter-spacing: 0.4px;
      text-transform: uppercase;
    }
    .spy-title {
      font-family: var(--serif);
      font-weight: 600;
    }
    .card-scroll {
      display: flex;
      gap: 10px;
      padding: 0 18px 6px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    .card-scroll::-webkit-scrollbar { height: 0; }
    .card {
      flex: 0 0 140px;
      height: 180px;
      background: var(--paper);
      border: 1.5px solid var(--ink);
      border-radius: 6px;
      padding: 10px;
      display: flex;
      flex-direction: column;
      scroll-snap-align: start;
      position: relative;
      box-shadow: 2px 2px 0 rgba(0,0,0,0.15);
      cursor: pointer;
      transition: transform 0.1s, box-shadow 0.1s;
    }
    .card:hover { transform: translateY(-2px); }
    .card.selected {
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(169,134,54,0.35), 4px 4px 0 rgba(0,0,0,0.15);
      transform: translateY(-4px);
    }
    .card.no-targets::after {
      content: "No targets";
      position: absolute;
      bottom: 6px;
      left: 10px;
      font-size: 9px;
      color: var(--danger);
      font-style: italic;
    }
    .card-type {
      font-size: 9px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 4px;
    }
    .card-title {
      font-family: var(--serif);
      font-size: 14px;
      line-height: 1.1;
      margin-bottom: 8px;
      font-weight: 500;
    }
    .card-authorization {
      font-size: 10px;
      line-height: 1.3;
      color: var(--ink-soft);
      flex-grow: 1;
    }
    .card-icons {
      display: flex;
      gap: 3px;
      margin-top: 6px;
      flex-wrap: wrap;
    }
    .unit-icon {
      width: 18px;
      height: 18px;
      background: var(--union);
      color: var(--paper);
      border-radius: 3px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 9px;
      font-weight: 700;
    }
    .unit-icon.cav { background: var(--csa); }
    .unit-icon.art { background: var(--danger); }
    .unit-icon.skr { background: var(--ok); }
    .unit-icon.sup { background: var(--gold); }
    .unit-icon.any { background: var(--ink); }
    .unit-icon.cmd { background: var(--paper); color: var(--gold); border: 1px solid var(--gold); }
    .card-footer {
      font-family: var(--mono);
      font-size: 9px;
      color: var(--ink-faint);
      margin-top: 4px;
      text-align: right;
    }

    /* UNITS */
    .unit {
      padding: 10px 0;
      border-bottom: 1px dashed var(--rule);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 10px;
      align-items: center;
      cursor: pointer;
      transition: background 0.1s;
    }
    .unit:last-child { border-bottom: none; }
    .unit:hover { background: rgba(169,134,54,0.04); }
    .unit.commander {
      background: rgba(169,134,54,0.06);
      margin: 0 -18px;
      padding: 10px 18px;
      border-left: 2px solid var(--gold);
    }
    .unit.glow {
      background: rgba(169,134,54,0.12);
      box-shadow: inset 3px 0 0 var(--gold);
      animation: pulse 1.6s ease-in-out infinite;
    }
    .unit.routed { opacity: 0.35; text-decoration: line-through; }
    @keyframes pulse {
      0%, 100% { background: rgba(169,134,54,0.10); }
      50% { background: rgba(169,134,54,0.22); }
    }
    .unit-badge {
      width: 36px;
      height: 36px;
      border-radius: 4px;
      background: var(--union);
      color: var(--paper);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--serif);
      font-size: 13px;
      font-weight: 700;
    }
    .unit-badge.cav { background: var(--csa); }
    .unit-badge.art { background: var(--danger); }
    .unit-badge.skr { background: var(--ok); }
    .unit-badge.sup { background: var(--gold); }
    .unit-badge.cmd {
      background: var(--paper);
      color: var(--gold);
      border: 1.5px solid var(--gold);
      font-size: 18px;
    }
    .unit-badge.enemy-side { background: var(--csa); }
    .unit-badge.enemy-side.cav { background: #4a2018; }
    .unit-info .unit-name {
      font-family: var(--serif);
      font-size: 13px;
      font-weight: 500;
      line-height: 1.1;
    }
    .unit-info .unit-sub {
      font-size: 10px;
      color: var(--ink-faint);
      margin-top: 2px;
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      align-items: center;
    }
    .unit-stats {
      text-align: right;
      font-family: var(--mono);
      font-size: 10px;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
    }
    .strength-bar {
      width: 60px;
      height: 4px;
      background: var(--paper-dark);
      border-radius: 2px;
      overflow: hidden;
    }
    .strength-bar-fill {
      height: 100%;
      background: var(--ok);
      transition: width 0.3s;
    }
    .strength-bar-fill.warn { background: var(--gold); }
    .strength-bar-fill.danger { background: var(--danger); }

    /* Chips & tags */
    .sector-chip {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      padding: 2px 7px;
      background: var(--paper-dark);
      border: 1px solid var(--rule);
      border-radius: 10px;
      font-size: 9px;
      color: var(--ink-soft);
      cursor: pointer;
    }
    .sector-chip::before {
      content: "◉";
      font-size: 7px;
      color: var(--ink-faint);
    }
    .sector-chip.pending {
      border-color: var(--gold);
      background: rgba(169,134,54,0.15);
      color: var(--gold);
      font-weight: 600;
    }
    .sector-chip.pending::before { color: var(--gold); content: "✦"; }

    .morale-mod {
      display: inline-block;
      padding: 1px 5px;
      border-radius: 3px;
      font-family: var(--mono);
      font-size: 9px;
      font-weight: 700;
    }
    .morale-mod.penalty { background: var(--danger); color: var(--paper); }
    .morale-mod.buff { background: var(--ok); color: var(--paper); }

    .unit-tag {
      padding: 1px 5px;
      background: var(--ink);
      color: var(--paper);
      border-radius: 6px;
      font-size: 8px;
      letter-spacing: 0.3px;
      text-transform: uppercase;
    }
    .unit-tag.building { background: var(--ok); }
    .unit-tag.activated { background: var(--ink); color: var(--gold-soft); border: 1px solid var(--gold); }
    .unit-tag.dry { background: var(--danger); }

    .ruler-hint {
      display: inline-flex;
      align-items: center;
      padding: 1px 5px;
      background: var(--ink);
      color: var(--paper);
      border-radius: 2px;
      font-family: var(--mono);
      font-size: 9px;
    }

    .mini-btn {
      padding: 4px 8px;
      background: var(--paper);
      border: 1px solid var(--ink);
      border-radius: 3px;
      font-family: var(--serif);
      font-size: 11px;
      cursor: pointer;
      color: var(--ink);
    }
    .mini-btn.danger { background: var(--danger); color: var(--paper); border-color: var(--danger); }

    /* ENEMY PANEL */
    .enemy-panel {
      border-bottom: 1px solid var(--rule);
    }
    .enemy-panel > summary {
      list-style: none;
      cursor: pointer;
      padding: 12px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(107, 58, 43, 0.06);
      border-left: 3px solid var(--csa);
    }
    .enemy-panel > summary::-webkit-details-marker { display: none; }
    .enemy-panel > summary .chev {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--ink-faint);
      transition: transform 0.2s;
    }
    .enemy-panel[open] > summary .chev { transform: rotate(90deg); }
    .enemy-summary-stats {
      display: flex;
      gap: 12px;
      font-family: var(--mono);
      font-size: 10px;
      color: var(--ink-soft);
      margin-top: 2px;
    }
    .enemy-summary-stats .pair b { color: var(--csa); font-weight: 700; }
    .enemy-body { padding: 4px 18px 12px; }

    /* LOG */
    .log {
      padding: 12px 18px;
      background: rgba(139, 115, 80, 0.08);
      border-bottom: 1px solid var(--rule);
      font-size: 11px;
      line-height: 1.5;
      color: var(--ink-soft);
    }
    .log-label {
      font-family: var(--serif);
      font-size: 10px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 6px;
    }
    .log-entry { margin-bottom: 4px; display: flex; gap: 6px; }
    .log-time {
      font-family: var(--mono);
      color: var(--ink-faint);
      flex-shrink: 0;
      min-width: 46px;
      font-size: 10px;
    }
    .log-dice {
      font-family: var(--mono);
      font-size: 9px;
      color: var(--ink-faint);
      display: block;
      margin-top: 2px;
    }

    /* ACTIONS */
    .actions {
      margin-top: auto;
      padding: 12px 14px 24px;
      background: var(--paper-dark);
      border-top: 2px solid var(--gold);
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 8px;
    }
    .action-btn {
      padding: 12px 6px;
      background: var(--paper);
      border: 1.5px solid var(--ink);
      border-radius: 6px;
      font-family: var(--serif);
      font-size: 12px;
      font-weight: 500;
      color: var(--ink);
      cursor: pointer;
    }
    .action-btn:hover { background: var(--ink); color: var(--paper); }
    .action-btn.primary {
      background: var(--union);
      color: var(--paper);
      border-color: var(--union);
    }

    /* MODAL / SCRIM */
    .scrim {
      position: fixed;
      inset: 0;
      background: rgba(20,16,12,0.6);
      backdrop-filter: blur(3px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 100;
    }
    .picker {
      width: 100%;
      max-width: 390px;
      background: var(--paper);
      border: 2px solid var(--gold);
      border-radius: 8px;
      box-shadow: 0 16px 40px rgba(0,0,0,0.5);
      padding: 16px;
      max-height: 90vh;
      overflow-y: auto;
    }
    .picker-header {
      text-align: center;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--rule);
      margin-bottom: 12px;
    }
    .picker-header .eyebrow {
      font-family: var(--serif);
      font-style: italic;
      font-size: 10px;
      color: var(--ink-faint);
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .picker-header .title {
      font-family: var(--serif);
      font-size: 15px;
      font-weight: 600;
      margin-top: 2px;
    }
    .picker-header .sub {
      font-size: 10px;
      color: var(--ink-soft);
      margin-top: 4px;
      font-style: italic;
    }

    .compass {
      text-align: center;
      font-family: var(--mono);
      font-size: 9px;
      color: var(--ink-faint);
      letter-spacing: 2px;
      padding: 4px 0 6px;
    }
    .compass .arrow { color: var(--union); font-weight: 700; }

    .grid-wrap {
      display: grid;
      grid-template-columns: auto 1fr 1fr 1fr;
      gap: 2px;
      margin-bottom: 8px;
    }
    .grid-col-header {
      text-align: center;
      font-family: var(--mono);
      font-size: 8px;
      letter-spacing: 1.5px;
      color: var(--ink-faint);
      padding-bottom: 6px;
      text-transform: uppercase;
    }
    .grid-row-header {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding-right: 6px;
      font-family: var(--mono);
      font-size: 8px;
      letter-spacing: 1px;
      color: var(--ink-faint);
      text-transform: uppercase;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }
    .grid-cell {
      aspect-ratio: 1;
      background: var(--paper-dark);
      border: 1px solid var(--rule);
      border-radius: 3px;
      padding: 6px;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      cursor: pointer;
      min-height: 72px;
    }
    .grid-cell:hover { background: var(--paper-deeper); }
    .grid-cell.current {
      border-style: dashed;
      border-color: var(--ink-faint);
      background: var(--paper);
    }
    .grid-cell.current::after {
      content: "WAS HERE";
      position: absolute;
      top: 4px;
      right: 4px;
      font-family: var(--mono);
      font-size: 7px;
      color: var(--ink-faint);
    }
    .grid-cell.selected {
      border: 2px solid var(--gold);
      background: rgba(169,134,54,0.2);
      box-shadow: 0 0 0 4px rgba(169,134,54,0.25);
    }
    .grid-cell.selected::after {
      content: "✦ NEW";
      position: absolute;
      top: 4px;
      right: 4px;
      font-family: var(--mono);
      font-size: 7px;
      color: var(--gold);
      font-weight: 700;
    }
    .grid-cell.enemy-zone {
      background: rgba(107,58,43,0.08);
      border-color: var(--csa-soft);
    }
    .cell-tokens { display: flex; flex-wrap: wrap; gap: 2px; }
    .token {
      width: 16px;
      height: 16px;
      background: var(--union);
      color: var(--paper);
      font-family: var(--serif);
      font-size: 9px;
      font-weight: 700;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .token.cav { background: var(--csa); }
    .token.art { background: var(--danger); }
    .token.skr { background: var(--ok); }
    .token.sup { background: var(--gold); color: var(--ink); }
    .token.cmd { background: var(--paper); color: var(--gold); border: 1px solid var(--gold); }
    .token.foe { opacity: 0.8; background: var(--csa-soft); }
    .token.foe.foe-cav { background: #4a2018; }
    .token.moving {
      border: 1.5px solid var(--gold);
      box-shadow: 0 0 5px var(--gold);
    }
    .cell-note {
      font-family: var(--mono);
      font-size: 7px;
      color: var(--ink-faint);
      letter-spacing: 0.3px;
    }

    .picker-footer {
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid var(--rule);
    }
    .picker-actions {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 8px;
    }
    .picker-btn {
      padding: 10px;
      font-family: var(--serif);
      font-size: 13px;
      border-radius: 4px;
      cursor: pointer;
      border: 1px solid var(--ink);
      background: var(--paper);
      color: var(--ink);
    }
    .picker-btn.primary {
      background: var(--gold);
      color: var(--ink);
      border-color: var(--gold);
      font-weight: 600;
    }
    .picker-btn.ghost { background: transparent; color: var(--ink-soft); }
    .picker-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    /* ATTACK TARGET LIST */
    .target-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 8px;
    }
    .target-row {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 10px;
      align-items: center;
      padding: 10px;
      background: var(--paper);
      border: 1px solid var(--rule);
      border-left: 3px solid var(--danger);
      border-radius: 4px;
      cursor: pointer;
    }
    .target-row:hover {
      background: rgba(139,47,47,0.06);
      border-color: var(--danger);
    }
    .target-info .target-name {
      font-family: var(--serif);
      font-size: 13px;
      font-weight: 600;
    }
    .target-info .target-sub {
      font-family: var(--mono);
      font-size: 10px;
      color: var(--ink-faint);
      margin-top: 2px;
    }
    .target-info .target-odds {
      font-size: 10px;
      color: var(--ink-soft);
      margin-top: 4px;
    }
    .target-go {
      font-family: var(--serif);
      font-size: 11px;
      font-weight: 600;
      color: var(--danger);
    }
    .no-targets-msg {
      text-align: center;
      padding: 20px;
      color: var(--ink-faint);
      font-style: italic;
      font-size: 12px;
    }

    /* DETAIL DRAWER (modal version) */
    .picker.detail { max-width: 420px; }
    .drawer { padding: 0; }
    .drawer-section { margin-bottom: 12px; }
    .drawer-label {
      font-family: var(--serif);
      font-style: italic;
      font-size: 10px;
      color: var(--ink-faint);
      letter-spacing: 0.5px;
      margin-bottom: 5px;
      text-transform: uppercase;
    }
    .drawer-row {
      display: grid;
      grid-template-columns: 90px 1fr;
      gap: 10px;
      padding: 3px 0;
      font-size: 11px;
      line-height: 1.3;
    }
    .drawer-row .k {
      color: var(--ink-faint);
      font-family: var(--mono);
      font-size: 10px;
    }
    .drawer-row .v b { font-weight: 700; }
    .pill-row { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 2px; }
    .pill {
      padding: 2px 7px;
      border-radius: 10px;
      font-size: 9px;
      letter-spacing: 0.3px;
      border: 1px solid var(--rule);
      background: var(--paper);
      color: var(--ink-soft);
    }
    .pill.hot { background: rgba(139,47,47,0.12); border-color: var(--danger); color: var(--danger); }
    .pill.warn { background: rgba(183,122,30,0.12); border-color: var(--warn); color: var(--warn); }
    .pill.good { background: rgba(63,93,61,0.12); border-color: var(--ok); color: var(--ok); }
    .pill.gold { background: rgba(169,134,54,0.15); border-color: var(--gold); color: var(--gold); font-weight: 600; }

    .figures { display: inline-flex; gap: 2px; flex-wrap: wrap; }
    .figure-dot {
      width: 8px; height: 10px;
      background: var(--union);
      border-radius: 1px;
    }
    .figure-dot.dead {
      background: transparent;
      border: 1px solid var(--ink-faint);
      opacity: 0.4;
    }
    .ammo-dots { display: inline-flex; gap: 3px; align-items: center; }
    .ammo-dot {
      width: 6px; height: 6px;
      background: var(--ink);
      border-radius: 50%;
    }
    .ammo-dot.spent {
      background: transparent;
      border: 1px solid var(--ink-faint);
      width: 4px; height: 4px;
    }
    .order-queue { display: flex; flex-direction: column; gap: 4px; }
    .order-item {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 8px;
      background: var(--paper);
      border: 1px solid var(--rule);
      border-left: 3px solid var(--gold);
      border-radius: 3px;
      font-size: 10px;
      line-height: 1.3;
    }
    .order-item.done {
      opacity: 0.5;
      text-decoration: line-through;
      border-left-color: var(--ok);
    }
    .order-item.ghost {
      border-left-color: var(--rule);
      color: var(--ink-faint);
      font-style: italic;
    }
    .order-item .step-num {
      font-family: var(--mono);
      color: var(--ink-faint);
      font-size: 9px;
      width: 14px;
      text-align: center;
    }
    .order-item .from-card {
      font-family: var(--serif);
      font-style: italic;
      font-size: 9px;
      color: var(--gold);
      margin-left: auto;
    }
  </style>
</body>
