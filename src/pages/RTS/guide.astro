    .hero h1 {
      font-family: var(--serif);
      font-size: 36px;
      font-weight: 600;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
      color: var(--union);
    }
    .hero .lede {
      font-family: var(--serif);
      font-style: italic;
      font-size: 15px;
      color: var(--ink-soft);
      line-height: 1.5;
      max-width: 440px;
      margin: 0 auto 18px;
    }
    .hero-meta {
      display: flex;
      justify-content: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .meta-chip {
      padding: 4px 10px;
      background: var(--paper-dark);
      border: 1px solid var(--rule);
      border-radius: 12px;
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.5px;
      color: var(--ink-soft);
    }

    /* ===== SECTION ===== */
    .s {
      position: relative;
      padding: 28px 0 20px;
      border-bottom: 1px solid rgba(160, 144, 120, 0.35);
    }
    .s:last-of-type { border-bottom: none; }
    .s-tag {
      position: absolute;
      top: 30px;
      right: 0;
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 1px;
      color: var(--ink-faint);
    }
    .s h2 {
      font-family: var(--serif);
      font-size: 24px;
      font-weight: 600;
      color: var(--union);
      margin-bottom: 8px;
      letter-spacing: 0.3px;
    }
    .s h3 {
      font-family: var(--serif);
      font-size: 16px;
      font-weight: 600;
      color: var(--ink);
      margin-top: 20px;
      margin-bottom: 10px;
    }
    .s p { margin-bottom: 10px; font-size: 14px; }
    .s-intro {
      font-family: var(--serif);
      font-style: italic;
      font-size: 15px !important;
      color: var(--ink-soft);
      line-height: 1.55;
      margin-bottom: 18px !important;
    }

    .ruler {
      display: inline-flex;
      align-items: center;
      padding: 1px 5px;
      background: var(--ink);
      color: var(--paper);
      border-radius: 2px;
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.5px;
      vertical-align: middle;
    }

    /* ===== AT A GLANCE ===== */
    .glance-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 18px;
    }
    .glance-cell {
      padding: 12px;
      background: var(--paper-dark);
      border: 1px solid var(--rule);
      border-radius: 4px;
      text-align: center;
    }
    .glance-num {
      font-family: var(--serif);
      font-size: 26px;
      font-weight: 700;
      color: var(--union);
      line-height: 1;
    }
    .glance-lbl {
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin: 4px 0 6px;
    }
    .glance-sub {
      font-size: 11px;
      color: var(--ink-soft);
      line-height: 1.35;
    }
    .gist {
      padding: 14px;
      background: rgba(30, 58, 95, 0.08);
      border-left: 3px solid var(--union);
      border-radius: 2px;
      font-size: 13px;
      line-height: 1.55;
    }

    /* ===== COMPONENTS ===== */
    .components {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin: 18px 0;
    }
    .comp {
      display: grid;
      grid-template-columns: 60px 1fr;
      gap: 12px;
      padding: 10px 0;
      align-items: flex-start;
    }
    .comp-icon {
      display: flex;
      justify-content: center;
      align-items: center;
      padding-top: 2px;
    }
    .comp-body h3 { margin: 0 0 4px !important; font-size: 15px !important; }
    .comp-body p { font-size: 13px; margin-bottom: 0; line-height: 1.5; }

    /* ===== UNIT TYPES ===== */
    .units-grid {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin: 18px 0;
    }
    .utype {
      display: grid;
      grid-template-columns: 48px 1fr;
      gap: 10px;
      padding: 12px;
      background: var(--paper-dark);
      border: 1px solid var(--rule);
      border-radius: 4px;
      border-left-width: 4px;
    }
    .utype.union { border-left-color: var(--union); }
    .utype.csa { border-left-color: var(--csa); }
    .utype.ok { border-left-color: var(--ok); }
    .utype.danger { border-left-color: var(--danger); }
    .utype.gold { border-left-color: var(--gold); }
    .utype.commander { border-left-color: var(--gold); background: rgba(169,134,54,0.06); }

    .utype-badge {
      width: 44px;
      height: 44px;
      border-radius: 4px;
      background: var(--union);
      color: var(--paper);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--serif);
      font-size: 18px;
      font-weight: 700;
      align-self: flex-start;
    }
    .utype-badge.cav { background: var(--csa); }
    .utype-badge.skr { background: var(--ok); }
    .utype-badge.art { background: var(--danger); }
    .utype-badge.sup { background: var(--gold); color: var(--ink); }
    .utype-badge.cmd {
      background: var(--paper);
      color: var(--gold);
      border: 1.5px solid var(--gold);
      font-size: 22px;
    }
    .utype-head { grid-column: 2; }
    .utype-name {
      font-family: var(--serif);
      font-size: 16px;
      font-weight: 600;
      color: var(--ink);
    }
    .utype-role {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 1px;
      color: var(--ink-faint);
      text-transform: uppercase;
      margin-top: 2px;
    }
    .utype-stats {
      grid-column: 1 / 3;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px 14px;
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px dashed var(--rule);
    }
    .utype-stats > div {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
    }
    .utype-stats .k { color: var(--ink-faint); font-family: var(--mono); font-size: 10px; }
    .utype-stats .v { font-weight: 600; }
    .utype-note {
      grid-column: 1 / 3;
      margin-top: 8px;
      font-size: 12px;
      color: var(--ink-soft);
      font-style: italic;
      line-height: 1.5;
    }

    /* ===== SECTOR DIAGRAM ===== */
    .sector-diagram { margin: 18px 0; }
    .sd-labels { text-align: center; margin-bottom: 6px; }
    .sd-facing {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 2px;
      color: var(--union);
      font-weight: 700;
    }
    .sd-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 4px;
      background: var(--paper-dark);
      padding: 4px;
      border-radius: 4px;
      border: 1px solid var(--rule);
    }
    .sd-cell {
      background: var(--paper);
      padding: 10px 6px;
      border-radius: 2px;
      min-height: 70px;
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .sd-cell-name {
      font-family: var(--serif);
      font-size: 11px;
      font-weight: 600;
      color: var(--union);
      margin-bottom: 2px;
    }
    .sd-cell-note {
      font-size: 9px;
      color: var(--ink-faint);
      line-height: 1.3;
    }
    .sd-mid { background: rgba(169,134,54,0.15); }
    .sd-back { background: rgba(107,58,43,0.06); }

    /* ===== RANGE TABLE ===== */
    .range-table {
      margin: 10px 0 18px;
      background: var(--paper-dark);
      border-radius: 4px;
      overflow: hidden;
      border: 1px solid var(--rule);
    }
    .rt-row {
      display: grid;
      grid-template-columns: 1.2fr 2fr auto;
      gap: 8px;
      padding: 8px 10px;
      font-size: 12px;
      align-items: center;
    }
    .rt-row:nth-child(odd) { background: rgba(232,223,201,0.5); }
    .rt-head {
      background: var(--union) !important;
      color: var(--paper);
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .band {
      padding: 2px 8px;
      border-radius: 10px;
      font-family: var(--mono);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }
    .band-melee { background: var(--danger); color: var(--paper); }
    .band-opt { background: var(--ok); color: var(--paper); }
    .band-ext { background: var(--gold); color: var(--ink); }
    .band-none { background: var(--ink-faint); color: var(--paper); }

    /* ===== RULER DIAGRAM ===== */
    .ruler-diagram { margin: 12px 0; }
    .ruler-row {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 10px;
    }
    .ruler-block {
      height: 24px;
      background: var(--gold);
      border: 1.5px solid var(--ink);
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 700;
      color: var(--ink);
    }
    .ruler-caption {
      font-size: 12px;
      color: var(--ink-soft);
    }

    /* ===== PHASE FLOW ===== */
    .phase-flow {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin: 18px 0;
    }
    .phase {
      display: grid;
      grid-template-columns: 40px 1fr;
      gap: 12px;
      width: 100%;
      padding: 12px 14px;
      background: var(--paper-dark);
      border: 1px solid var(--rule);
      border-left: 4px solid var(--union);
      border-radius: 4px;
    }
    .phase-num {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--union);
      color: var(--paper);
      font-family: var(--serif);
      font-size: 15px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .phase-name {
      font-family: var(--serif);
      font-size: 16px;
      font-weight: 600;
      color: var(--union);
      margin-bottom: 4px;
    }
    .phase p { font-size: 12px; margin-bottom: 0; line-height: 1.5; }
    .phase-arrow {
      color: var(--gold);
      font-size: 14px;
      margin: 4px 0;
    }
    .callout {
      margin-top: 16px;
      padding: 12px 14px;
      background: rgba(169,134,54,0.08);
      border-left: 3px solid var(--gold);
      border-radius: 2px;
    }
    .callout-label {
      font-family: var(--serif);
      font-style: italic;
      font-size: 11px;
      color: var(--gold);
      margin-bottom: 4px;
      letter-spacing: 0.5px;
    }
    .callout p { font-size: 12px; margin-bottom: 0; line-height: 1.5; }

    /* ===== CARD DEMO ===== */
    .card-demo {
      display: grid;
      grid-template-columns: 140px 1fr;
      gap: 16px;
      margin: 16px 0;
      align-items: flex-start;
    }
    .card-visual {
      background: var(--paper);
      border: 2px solid var(--ink);
      border-radius: 6px;
      padding: 10px;
      height: 180px;
      display: flex;
      flex-direction: column;
      box-shadow: 3px 3px 0 rgba(0,0,0,0.15);
    }
    .cv-type {
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 4px;
    }
    .cv-title {
      font-family: var(--serif);
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 8px;
    }
    .cv-body { font-size: 10px; color: var(--ink-soft); flex-grow: 1; line-height: 1.4; }
    .cv-icons { display: flex; gap: 3px; margin-top: 4px; }
    .cv-icon {
      width: 18px;
      height: 18px;
      background: var(--union);
      color: var(--paper);
      border-radius: 3px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 9px;
      font-weight: 700;
    }
    .cv-footer {
      font-family: var(--mono);
      font-size: 8px;
      color: var(--ink-faint);
      text-align: right;
      margin-top: 4px;
    }
    .card-annotations {
      display: flex;
      flex-direction: column;
      gap: 8px;
      font-size: 11px;
      line-height: 1.45;
    }
    .ann { display: flex; gap: 6px; }
    .ann-dot {
      width: 6px;
      height: 6px;
      background: var(--gold);
      border-radius: 50%;
      margin-top: 6px;
      flex-shrink: 0;
    }

    /* ===== AUTH LIST ===== */
    .auth-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin: 10px 0 18px;
    }
    .auth {
      padding: 8px 12px;
      background: var(--paper-dark);
      border-left: 3px solid var(--gold);
      border-radius: 2px;
      font-size: 12px;
      line-height: 1.5;
    }

    /* ===== HAND ECONOMY ===== */
    .hand-econ {
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
      gap: 4px;
      align-items: center;
      margin: 14px 0;
    }
    .econ-stat { text-align: center; padding: 8px 4px; }
    .econ-big {
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 700;
      color: var(--union);
    }
    .econ-stat > div:last-child {
      font-size: 10px;
      color: var(--ink-faint);
      line-height: 1.3;
      margin-top: 2px;
    }
    .econ-arrow { color: var(--gold); font-size: 16px; }

    /* ===== MOVE TABLE ===== */
    .move-table {
      margin: 12px 0 18px;
      background: var(--paper-dark);
      border-radius: 4px;
      overflow: hidden;
      border: 1px solid var(--rule);
    }
    .mt-row {
      display: grid;
      grid-template-columns: 1fr auto;
      padding: 8px 12px;
      align-items: center;
      font-size: 13px;
    }
    .mt-row:nth-child(odd) { background: rgba(232,223,201,0.5); }
    .mt-unit { display: flex; align-items: center; gap: 8px; }
    .badge {
      display: inline-flex;
      width: 22px;
      height: 22px;
      background: var(--union);
      color: var(--paper);
      border-radius: 3px;
      align-items: center;
      justify-content: center;
      font-family: var(--serif);
      font-size: 12px;
      font-weight: 700;
    }
    .badge.inf { background: var(--union); }
    .badge.cav { background: var(--csa); }
    .badge.skr { background: var(--ok); }
    .badge.art { background: var(--danger); }
    .badge.sup { background: var(--gold); color: var(--ink); }
    .badge.cmd {
      background: var(--paper);
      color: var(--gold);
      border: 1px solid var(--gold);
    }

    /* ===== HIT TABLE ===== */
    .hit-table {
      margin: 10px 0 14px;
      background: var(--paper-dark);
      border-radius: 4px;
      overflow: hidden;
      border: 1px solid var(--rule);
    }
    .ht-row {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      padding: 8px 12px;
      font-size: 13px;
      text-align: center;
      align-items: center;
    }
    .ht-row > div:first-child { text-align: left; display: flex; align-items: center; gap: 8px; }
    .ht-row:nth-child(odd) { background: rgba(232,223,201,0.5); }
    .ht-head {
      background: var(--union) !important;
      color: var(--paper);
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .cover-note { font-size: 12px; color: var(--ink-soft); font-style: italic; }

    /* ===== LETHALITY MODS ===== */
    .leth-mods {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin: 10px 0 16px;
    }
    .lm {
      display: grid;
      grid-template-columns: 70px 1fr;
      gap: 10px;
      padding: 6px 10px;
      background: var(--paper-dark);
      border-radius: 3px;
      font-size: 12px;
      align-items: center;
    }
    .lm-sign {
      font-family: var(--mono);
      font-weight: 700;
      text-align: center;
      padding: 3px 6px;
      border-radius: 3px;
      background: var(--paper);
      border: 1px solid var(--rule);
      font-size: 11px;
    }
    .lm-sign.plus { background: var(--ok); color: var(--paper); border-color: var(--ok); }
    .lm-sign.minus { background: var(--danger); color: var(--paper); border-color: var(--danger); }

    /* ===== EXAMPLE ATTACK ===== */
    .example {
      margin: 14px 0 18px;
      padding: 14px;
      background: rgba(30,58,95,0.05);
      border: 1px solid var(--rule);
      border-left: 3px solid var(--union);
      border-radius: 3px;
    }
    .example > p { font-size: 13px; line-height: 1.5; }
    .ex-roll { margin: 10px 0; }
    .ex-label {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 1px;
      color: var(--ink-faint);
      margin-bottom: 4px;
      text-transform: uppercase;
    }
    .dice-row {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-bottom: 4px;
    }
    .die {
      width: 24px;
      height: 24px;
      background: var(--paper);
      border: 1px solid var(--rule);
      border-radius: 3px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--serif);
      font-size: 13px;
      font-weight: 700;
      color: var(--ink-faint);
    }
    .die.hit {
      background: var(--ok);
      color: var(--paper);
      border-color: var(--ok);
    }
    .ex-result {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--ok);
      font-weight: 700;
      margin-top: 4px;
    }
    .ex-out {
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px dashed var(--rule);
      font-size: 13px !important;
    }

    /* ===== MELEE DIAGRAM ===== */
    .melee-diagram {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 14px;
      margin: 16px 0;
      align-items: center;
    }
    .md-side { text-align: center; }
    .md-head {
      font-family: var(--serif);
      font-weight: 600;
      font-size: 13px;
      margin-bottom: 6px;
    }
    .md-side.union .md-head { color: var(--union); }
    .md-side.csa .md-head { color: var(--csa); }
    .md-figs {
      display: flex;
      gap: 3px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .md-f {
      width: 14px;
      height: 20px;
      border-radius: 2px;
    }
    .md-f.u { background: var(--union); }
    .md-f.c { background: var(--csa); }
    .md-vs {
      font-family: var(--serif);
      font-weight: 700;
      font-size: 20px;
      color: var(--gold);
    }
    .md-note {
      font-size: 12px !important;
      color: var(--ink-soft);
      font-style: italic;
      margin-bottom: 14px !important;
    }

    /* ===== MORALE VIZ ===== */
    .morale-viz {
      margin: 16px 0;
      padding: 14px;
      background: var(--paper-dark);
      border-radius: 4px;
      border: 1px solid var(--rule);
    }
    .mv-rail {
      display: grid;
      grid-template-columns: 50px 1fr;
      gap: 10px;
      margin-bottom: 6px;
      align-items: center;
    }
    .mv-label {
      font-family: var(--mono);
      font-size: 10px;
      font-weight: 700;
      text-align: right;
      color: var(--ink-soft);
    }
    .mv-bar {
      height: 10px;
      background: var(--paper);
      border: 1px solid var(--rule);
      border-radius: 2px;
      position: relative;
    }
    .mv-fill {
      position: absolute;
      top: 0;
      bottom: 0;
      border-radius: 2px;
    }
    .morale-list {
      margin: 12px 0 14px;
      padding-left: 20px;
      font-size: 13px;
      line-height: 1.7;
    }

    /* ===== COMMANDER DIAGRAM ===== */
    .cmdr-diagram {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 8px;
      margin: 12px 0;
      align-items: center;
    }
    .cmdr-unit {
      padding: 10px;
      background: var(--paper-dark);
      border: 1px solid var(--rule);
      border-radius: 4px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      text-align: center;
    }
    .cmdr-badge {
      width: 34px;
      height: 34px;
      border-radius: 4px;
      background: var(--paper);
      color: var(--gold);
      border: 1.5px solid var(--gold);
      font-family: var(--serif);
      font-size: 18px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .cmdr-badge.inf {
      background: var(--union);
      color: var(--paper);
      border: none;
    }
    .cmdr-text {
      font-size: 11px;
      line-height: 1.4;
    }
    .cmdr-text span {
      font-family: var(--mono);
      font-size: 9px;
      color: var(--ink-faint);
    }
    .cmdr-arrow {
      color: var(--gold);
      font-size: 18px;
    }

    /* ===== VICTORY VIZ ===== */
    .victory-viz {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 12px;
      margin: 16px 0;
      align-items: center;
      padding: 14px;
      background: #15283f;
      border-radius: 4px;
    }
    .vv-side { text-align: center; color: var(--paper); }
    .vv-label {
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      opacity: 0.7;
      margin-bottom: 6px;
    }
    .vv-banners { display: flex; gap: 3px; justify-content: center; }
    .vv-b {
      width: 11px;
      height: 14px;
      background: transparent;
      border: 1px solid var(--paper);
      opacity: 0.35;
    }
    .vv-b.taken {
      background: var(--gold);
      border-color: var(--gold);
      opacity: 1;
    }
    .vv-b.taken.csa {
      background: var(--csa-soft);
      border-color: var(--csa-soft);
    }
    .vv-count {
      margin-top: 6px;
      font-family: var(--mono);
      font-size: 11px;
    }
    .vv-mid {
      font-family: var(--serif);
      font-size: 16px;
      color: var(--gold);
    }
    .victory-list {
      padding-left: 20px;
      font-size: 13px;
      line-height: 1.7;
    }

    /* ===== OPEN QUESTIONS ===== */
    .oq-list { margin: 14px 0; display: flex; flex-direction: column; gap: 10px; }
    .oq {
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: 10px;
      padding: 10px 12px;
      background: rgba(169,134,54,0.08);
      border-left: 3px solid var(--gold);
      border-radius: 3px;
      font-size: 12px;
      line-height: 1.55;
    }
    .oq-num {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--gold);
      color: var(--ink);
      font-family: var(--serif);
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
    }

    /* ===== COMMENT BLOCK ===== */
    .comment-block {
      margin-top: 18px;
      padding: 14px;
      background: rgba(30,58,95,0.05);
      border: 1px dashed var(--rule);
      border-left: 3px solid var(--gold);
      border-radius: 3px;
    }
    .comment-block label {
      display: block;
      font-family: var(--serif);
      font-style: italic;
      font-size: 12px;
      color: var(--gold);
      margin-bottom: 6px;
      letter-spacing: 0.3px;
    }
    .comment-block textarea {
      width: 100%;
      min-height: 64px;
      padding: 10px;
      background: var(--paper);
      border: 1px solid var(--rule);
      border-radius: 3px;
      font-family: var(--sans);
      font-size: 13px;
      color: var(--ink);
      resize: vertical;
      line-height: 1.5;
    }
    .comment-block textarea:focus {
      outline: none;
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(169,134,54,0.2);
    }

    /* ===== SUBMIT ===== */
    .submit-section {
      margin-top: 36px;
      padding: 24px 20px;
      background: var(--union);
      color: var(--paper);
      border-radius: 6px;
      text-align: center;
    }
    .submit-section h2 {
      color: var(--paper) !important;
      font-size: 22px !important;
    }
    .submit-section .s-intro {
      color: rgba(232,223,201,0.85) !important;
      font-size: 14px !important;
    }
    .submit-row {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin: 18px 0 10px;
    }
    .submit-btn {
      padding: 14px;
      background: var(--gold);
      color: var(--ink);
      border: none;
      border-radius: 4px;
      font-family: var(--serif);
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      letter-spacing: 0.3px;
    }
    .submit-btn:hover { background: var(--gold-soft); }
    .clear-btn {
      padding: 8px;
      background: transparent;
      color: rgba(232,223,201,0.6);
      border: 1px solid rgba(232,223,201,0.3);
      border-radius: 4px;
      font-family: var(--sans);
      font-size: 12px;
      cursor: pointer;
    }
    .clear-btn:hover { color: var(--paper); border-color: var(--paper); }
    .save-indicator {
      font-family: var(--mono);
      font-size: 10px;
      color: rgba(232,223,201,0.5);
      letter-spacing: 1px;
      margin-top: 6px;
    }
    .save-indicator.flash {
      color: var(--gold);
      font-weight: 600;
    }

    .foot {
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid var(--rule);
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      color: var(--ink-faint);
      font-style: italic;
    }
    .foot a { color: var(--ink-faint); text-decoration: underline; }
    .foot a:hover { color: var(--gold); }

    /* ===== RESPONSIVE TIGHTENING ===== */
    @media (max-width: 400px) {
      .card-demo { grid-template-columns: 1fr; }
      .card-visual { margin: 0 auto; }
      .hand-econ { grid-template-columns: 1fr; gap: 2px; }
      .econ-arrow { display: none; }
      .glance-grid { grid-template-columns: 1fr; }
    }
  </style>
</body>
</html>
