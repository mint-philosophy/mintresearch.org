{
  "name": "minty-chatbot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "sync:site-papers": "python3 setup/sync_site_papers.py --csv ../public/assets/papers/latest-paper-deliverables.csv --output-dir setup/generated-site-papers --download-arxiv-pdfs",
    "refresh:vector-store": "python3 setup/create_assistant.py --vector-store-only --fresh-vector-store --publications-dir setup/publications setup/generated-site-papers",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.78.0"
  }
}
